# Cloudflare Worker 统一密码配置文件
# 复制此文件为 .dev.vars (用于本地 wrangler dev) 或 .env
# 生产环境通过 `npx wrangler secret put ROUTES_KEY` 注入

# 统一主密码：
# 1. 用于在公开仓库中对 routes.ts 进行极速对称加解密 (AES-GCM)
# 2. 作为所有受保护短链 (password: true) 的统一访问验证密码
ROUTES_KEY=stevezmt_secure_pass_2026

# （可选）若需要让访客访问密码与 ROUTES_KEY 分离，可单独配置：
# AUTH_PASSWORD=guest_access_password
