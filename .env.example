# Cloudflare Worker 统一密码配置文件
# 复制此文件为 .dev.vars (用于本地 wrangler dev) 或 .env
# 生产环境通过 `npx wrangler secret put ROUTES_KEY` 注入

# 统一主密码：
# 1. 用于在公开仓库中对 routes.ts 进行极速对称加解密 (AES-GCM)
# 2. 作为所有受保护短链 (password: true) 的统一访问验证密码
# 3. 亦可作为 Altcha HMAC 签发挑战的默认回退密钥
ROUTES_KEY=stevezmt_secure_pass_2026

# （可选）若需要让访客访问密码与 ROUTES_KEY 分离，可单独配置：
# AUTH_PASSWORD=guest_access_password

# ==========================================
# 人机验证与防爬工作量证明配置 (Turnstile / Altcha / Cap)
# 用于保护单目标加密链接，抬高爬取成本，防止公网遍历导出表
# ==========================================
# 选型：turnstile | altcha | cap (亦可在 routes.ts settings.challenge.provider 中指定)
CHALLENGE_PROVIDER=turnstile

# 1. Cloudflare Turnstile (推荐 Cloudflare 原生集成)
# 获取地址：https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAATestSiteKey
TURNSTILE_SECRET_KEY=0x4AAAAAAATestSecretKey

# 2. Altcha (零外部网络请求，边缘原生 WebCrypto HMAC-SHA256 计算)
# 若留空则自动使用上面的 ROUTES_KEY
# ALTCHA_HMAC_KEY=altcha_hmac_secret_key_at_least_32_chars

# 3. Cap (开源验证码系统，支持官方云端与自建 Docker 实例)
# CAP_SITE_KEY=cap_site_key_123
# CAP_SECRET_KEY=cap_secret_key_xyz
# CAP_ENDPOINT=https://api.trycap.dev

